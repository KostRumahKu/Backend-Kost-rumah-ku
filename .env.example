# ==== JIKA TIDAK ADA KETERANGAN STRING ISI LANGSUNG VALUE TANPA TANDA "" ====


# Port yang digunakan backend untuk menerima request.
PORT=3000
# node proses.
NODE_ENV=development
# Kunci internal untuk request yang mengirim header x-internal-key.
INTERNAL_KEY=
# Connection string MongoDB.
MONGODB_URI=
# Secret untuk memverifikasi JWT.
JWT_SECRET=
# Masa berlaku token JWT, contoh: 2h, 1d.
JWT_EXPIRES_IN=2h

# API key Resend yang diperlukan untuk mengirim email transaksional.
RESEND_API_KEY=
# Alamat pengirim yang sudah diverifikasi di Resend.
SENDER_EMAIL=noreply@domainanda.com <- ini contoh biasa nya nanti di resend ada 
# Nama pengirim yang terlihat oleh penerima email.
EMAIL_FROM_NAME=KostRumahKu

# Nama aplikasi yang ditampilkan di template email, subjek email, dan invoice.
APP_NAME=KostRumahKu
# Nama admin yang ditampilkan di salam dan bagian kontak invoice.
ADMIN_NAME=Admin KostRumahKu -auvia
# URL website publik untuk tautan website dan halaman pembayaran;
APP_URL=https://kostrumahku.com
# Alamat penerima notifikasi email admin.
ADMIN_EMAIL=admin@kostrumahku.com
# Alamat usaha yang dicetak di bagian atas invoice.
BUSINESS_EMAIL=admin@kostrumahku.com
# Alamat owner yang dicetak di bagian bantuan invoice.
OWNER_EMAIL=admin@kostrumahku.com
# URL halaman pengajuan dashboard yang ditautkan pada email pengingat admin. (Nunggu fe)
ADMIN_DASHBOARD_URL=https:////pengajuan
# URL halaman tagihan admin yang ditautkan pada email pembayaran masuk. (Nunggu FE)
ADMIN_TAGIHAN_URL=https:///tagihan

# Alamat usaha yang dicetak pada invoice PDF.
BUSINESS_ADDRESS=Jl. Margonda Raya No. 100, Depok, Jawa Barat
# Nomor telepon yang dicetak pada invoice PDF. +62
BUSINESS_PHONE=+62 812-3456-7890
# Nomor WhatsApp pada bagian pusat bantuan invoice; jika kosong bakal pakai BUSINESS_PHONE.
BUSINESS_WHATSAPP=+62 812-3456-7890
# Akun media sosial yang dicetak pada invoice PDF.
BUSINESS_SOCIAL=@kostrumahku.official
# Jam operasional yang dicetak pada invoice PDF.
BUSINESS_OPERATING_HOURS=Sen - Sab (08:00 - 14:00 WIB)
# URL gambar profil bawaan bagi akun yang belum upload foto (biasa nya diawal.
DEFAULT_PROFILE_IMAGE_URL=https://uploader.danafxc.my.id/images/8c67c844-421b-470a-aa42-476429f8cce2.png

BACKEND_VERSION=0.4.2-RC